# Dockerfile.uv — development image that installs uv and sets up environment
# Build: 'docker build -t lexicon-uv-dev -f Dockerfile.uv .' to run
# Run: 'docker run --rm -it -v $(pwd):/work -w /work lexicon-uv-dev /bin/bash'
# Use: 'lexicon efficientip --no-verify-ssl --auth-username <usr> --auth-password <pwd> --sds-host <host> --sds-dns <dns_name> list test.priv A'
# Debug: add '--log-level DEBUG' at the end of the command above to see uv/lexicon debug logs
FROM python:3.12-slim

# metadata
ENV DEBIAN_FRONTEND=noninteractive
WORKDIR /work

# install small OS deps needed for building packages and curl for uv installer
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
       build-essential \
       git \
       curl \
       ca-certificates \
       procps \
    && rm -rf /var/lib/apt/lists/*

# copy project files (we still mount the workspace at runtime for live edits)
COPY . /work

# Create a non-root user for development ergonomics (optional)
# (dev user creation moved below so installer runs as root)
RUN useradd -m dev -s /bin/bash \
    && mkdir -p /home/dev/.local/bin \
    && chown -R dev:dev /home/dev/.local \
    && chown -R dev:dev /work \
    && printf '%s\n' 'source /work/.venv/bin/activate' > /home/dev/.bashrc \
    && chown dev:dev /home/dev/.bashrc

USER dev
ENV HOME=/home/dev
WORKDIR /work

# install uv using upstream installer (uses curl pipe -> sh)
# run installer from the project workdir so it executes in that context
# this will install uv into /usr/local/bin/uv (installer's default)
# install uv using upstream installer (uses curl pipe -> sh)
# run installer from the project workdir so it executes in that context
# this will install uv into /usr/local/bin/uv (installer's default)
RUN set -eux; cd /work; curl -fsSL https://astral.sh/uv/install.sh | sh

# make sure uv is on PATH (installer typically does this already)
# include dev user's local bin so PATH stays valid after switching users
ENV PATH=/home/dev/.local/bin:/root/.local/bin:/usr/local/bin:$PATH

# Use uv to install dependencies into the container's Python
# --extra full is commonly used by projects needing dev deps; remove if you only want runtime deps
RUN uv sync --extra full

# default to an interactive shell so devs can drop in and run uvx/pytest etc
CMD ["/bin/bash"]

